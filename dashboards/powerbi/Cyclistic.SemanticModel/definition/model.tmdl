model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataSourceUrl","Rider Summary","Rides by Weekday","Rides by Hour","Rider Type","Year","Key Measures"]

ref table 'Key Measures'
ref table 'Rider Summary'
ref table 'Rides by Weekday'
ref table 'Rides by Hour'
ref table 'Rider Type'
ref table Year

ref cultureInfo en-US
