table 'Key Measures'

	measure 'Total Rides' = SUM ( 'Rider Summary'[Ride Count] )
		formatString: #,0
		displayFolder: Rides

	measure 'Member Rides' = CALCULATE ( [Total Rides], 'Rider Type'[Rider Type] = "Member" )
		formatString: #,0
		displayFolder: Rides

	measure 'Casual Rides' = CALCULATE ( [Total Rides], 'Rider Type'[Rider Type] = "Casual" )
		formatString: #,0
		displayFolder: Rides

	measure 'Member Share' = DIVIDE ( [Member Rides], [Total Rides] )
		formatString: 0.0%
		displayFolder: Rides

	measure 'Rides YoY %' =
			VAR _year = SELECTEDVALUE ( 'Year'[Year] )
			VAR _current = [Total Rides]
			VAR _previous = CALCULATE ( [Total Rides], 'Year'[Year] = _year - 1 )
			RETURN
				IF ( NOT ISBLANK ( _previous ), DIVIDE ( _current - _previous, _previous ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Rides

	measure 'Avg Ride (min)' =
			DIVIDE (
				SUMX ( 'Rider Summary', 'Rider Summary'[Ride Count] * 'Rider Summary'[Avg Ride Length (min)] ),
				[Total Rides]
			)
		formatString: 0.0
		displayFolder: Duration

	measure 'Median Ride (min)' =
			-- Medians are not additive: only defined for one rider type in one year
			IF (
				HASONEVALUE ( 'Rider Type'[Rider Type] ) && HASONEVALUE ( 'Year'[Year] ),
				MAX ( 'Rider Summary'[Median Ride Length (min)] )
			)
		formatString: 0.0
		displayFolder: Duration

	measure 'Median Ride Member (min)' = CALCULATE ( [Median Ride (min)], 'Rider Type'[Rider Type] = "Member" )
		formatString: 0.0
		displayFolder: Duration

	measure 'Median Ride Casual (min)' = CALCULATE ( [Median Ride (min)], 'Rider Type'[Rider Type] = "Casual" )
		formatString: 0.0
		displayFolder: Duration

	measure 'Weekday Rides' = SUM ( 'Rides by Weekday'[Ride Count] )
		formatString: #,0
		displayFolder: Patterns

	measure 'Weekday Share' =
			-- Share of a rider group's weekly rides that fall on each day
			DIVIDE (
				[Weekday Rides],
				CALCULATE (
					[Weekday Rides],
					REMOVEFILTERS ( 'Rides by Weekday'[Day], 'Rides by Weekday'[Day Name], 'Rides by Weekday'[Weekday Order] )
				)
			)
		formatString: 0.0%
		displayFolder: Patterns

	measure 'Hourly Rides' = SUM ( 'Rides by Hour'[Ride Count] )
		formatString: #,0
		displayFolder: Patterns

	measure 'Hourly Share' =
			-- Share of a rider group's daily rides that start in each hour
			DIVIDE (
				[Hourly Rides],
				CALCULATE ( [Hourly Rides], REMOVEFILTERS ( 'Rides by Hour'[Start Hour] ) )
			)
		formatString: 0.0%
		displayFolder: Patterns

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Placeholder


	partition 'Key Measures' = m
		mode: import
		source = #table(type table [Placeholder = text], {})
