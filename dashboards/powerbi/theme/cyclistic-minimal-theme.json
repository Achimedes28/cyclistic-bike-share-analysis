{
  "name": "Cyclistic Minimal",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#4A3AA7",
    "#E34948"
  ],
  "foreground": "#0B0B0B",
  "foregroundNeutralSecondary": "#52514E",
  "foregroundNeutralTertiary": "#8A8984",
  "background": "#FFFFFF",
  "backgroundLight": "#F6F6F3",
  "backgroundNeutral": "#E6E5E0",
  "tableAccent": "#2A78D6",
  "good": "#1BAF7A",
  "neutral": "#EDA100",
  "bad": "#E34948",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#52514E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6E5E0"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 10,
            "left": 14,
            "right": 14
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EEEDE9"
              }
            },
            "gridlineStyle": "solid",
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8A8984"
              }
            },
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F6F6F3"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F6F6F3"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 4,
            "right": 4
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEEDE9"
              }
            },
            "gridVertical": false,
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "total": [
          {
            "totals": false
          }
        ]
      }
    }
  }
}
